# Copy to .env.local and fill in. Never commit real values.

# Hospital WhatsApp number that receives consultation requests (digits only,
# with 91 in front). It can also be changed in the dashboard settings.
HOSPITAL_WHATSAPP=91XXXXXXXXXX

# Public address of the site, used in links inside WhatsApp messages.
# Leave empty locally; the request's own address is used.
SITE_URL=https://your-site.example

# Long random secret for signing patient links (tracker and feedback).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Supabase (server side: secret key, never exposed to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# Supabase (browser side, for the doctor's sign-in and live updates)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel Cron sends this as a Bearer token to /api/app/cron/cleanup.
CRON_SECRET=

# Zoom Server-to-Server OAuth app. Set PROVIDERS_MODE=live to create real
# meetings; otherwise test meeting links are used.
PROVIDERS_MODE=mock
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Local only: CONSULT_STORE=memory runs everything in memory (no Supabase),
# with a demo dashboard login doctor@demo.local / DEMO_PASSWORD (default "demo").
# Ignored on Vercel.
# CONSULT_STORE=memory
# DEMO_PASSWORD=demo

# Web push notifications for the staff dashboard app. Generate with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-site.example
