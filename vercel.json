{
  "buildCommand": "pnpm --filter @workspace/sri-sai-hospital run build",
  "outputDirectory": "artifacts/sri-sai-hospital/dist/public",
  "crons": [
    {
      "path": "/api/app/cron/cleanup",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/app/(.*)",
      "destination": "/api/app?route=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
